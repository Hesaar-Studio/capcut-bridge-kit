{
  "name": "hs-tech-ai-video-bridge",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "version": "2.4.0",
  "description": "HS.Tech AI Video Bridge desktop application and control dashboard",
  "type": "module",
  "main": "bridge_system/electron_main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "electron .",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=build/desktop/backend.cjs",
    "build:desktop": "npm run build && npm run build:server",
    "build:python:win": "python scripts/build-python-services.py",
    "build:win": "node scripts/build-win.mjs",
    "build:win:installer": "npm run build:win",
    "build:win:check": "node scripts/build-win.mjs --validate-only",
    "package:source": "python scripts/package-source.py",
    "package:win": "electron-builder --win nsis --x64",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true}); require('node:fs').rmSync('build/desktop',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.cjs tests/*.test.mjs tests/*.test.ts && python -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "build": {
    "appId": "com.hesaart.capcutbridge",
    "productName": "HS.Tech AI Video Bridge",
    "copyright": "Copyright © 2026 Hesaar Studio",
    "asar": true,
    "directories": {
      "output": "release/artifacts",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "build/desktop/backend.cjs",
      "bridge_system/**/*.cjs",
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release/runtime/python-services",
        "to": "python-services",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/hs-tech-bridge.ico",
      "artifactName": "HS.Tech-Bridge-Setup-x64.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HS.Tech AI Video Bridge",
      "uninstallDisplayName": "HS.Tech AI Video Bridge",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
